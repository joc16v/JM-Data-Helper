<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JMDataHelper</AssemblyName>
    <RootNamespace>JMDataHelper</RootNamespace>
    <Version>0.2.2</Version>
    <ApplicationIcon>Assets\JMDataHelper.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**;artifacts\**" />
    <EmbeddedResource Include="Assets\JMDataHelper.ico" LogicalName="JMDataHelper.AppIcon.ico" />
    <Content Update="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
